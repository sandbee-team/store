{
  "name": "sandbee-platform",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/ocr"
  ],
  "scripts": {
    "setup": "node scripts/setup.js",
    "start": "node server.js",
    "build": "vite build",
    "dev": "vite --host 127.0.0.1",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "test:ui": "playwright test",
    "package:ocr": "node scripts/pack-ocr.js",
    "format": "prettier --write backend frontend/src frontend/public/developers.css packages/ocr/src \"services/**/*.js\" test scripts server.js"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@radix-ui/react-select": "^2.3.7",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "get-nonce": "^1.0.1",
    "helmet": "^8.3.0",
    "lru-cache": "^11.5.3",
    "lucide-react": "^1.47.0",
    "mongodb": "^7.6.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.9.8",
    "vite": "^8.3.0"
  }
}
