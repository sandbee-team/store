  "capabilities": {
    "exports": [
      "extract",
      "extractBatch"
    ],
    "documentTypes": [
      "AADHAAR",
      "PAN",
      "VOTER_ID",
      "DRIVING_LICENSE",
      "RATION_CARD",
      "PASSPORT"
    ],
    "options": {
      "enableQr": "boolean",
      "enableOcr": "boolean",
      "enablePreprocessing": "boolean",
      "enableNeural": "boolean",
      "returnRawText": "boolean",
      "returnDebugInfo": "boolean",
      "maxPages": "int [1,20]",
      "timeoutMs": "int [100,600000]",
      "neuralThreads": "int [0,2]",
      "pdfPassword": "string"
    },
    "envelope": {
      "always": [
        "success",
        "documentType",
        "layout",
        "fileType",
        "data",
        "validations",
        "confidence",
        "quality",
        "processingTimeMs",
        "source",
        "errors"
      ],
      "optional": [
        "fieldDetails",
        "engines",
        "rawText",
        "debug",
        "resources",
        "batch"
      ],
      "notes": "engines AND fieldDetails are OMITTED on the fatal path (BuildFatalResult); resources is absent on the two synchronous fatal paths (bad input, QUEUE_FULL); batch appears only on extractBatch envelopes; the promise never rejects"
    }
  },
