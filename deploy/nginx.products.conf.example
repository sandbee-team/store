# Add inside the Store TLS vhost before location /; demo stays on Store origin.
location = /api/demo/extract {
  client_max_body_size 21m;
  proxy_pass http://127.0.0.1:8096;
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-For $remote_addr;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_http_version 1.1;
  proxy_read_timeout 80s;
  proxy_send_timeout 80s;
  proxy_connect_timeout 5s;
}
# gstapi.sandbee.in: whole TLS vhost location / -> http://127.0.0.1:8095
# ocrapi.sandbee.in: whole TLS vhost location / -> http://127.0.0.1:8097
# Both APIs return JSON 404 at /; no frontend exists.
# Use the complete domain examples in the final kit nginx directory.
