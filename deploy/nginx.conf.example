# Include these locations in your existing TLS vhost for store.sandbee.in.
# Set the host and certificates using your current reverse-proxy/certificate setup.
# The application container is reachable only on host loopback.
server {
  listen 443 ssl;
  server_name store.sandbee.in;
  ssl_certificate /etc/letsencrypt/live/store.sandbee.in/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/store.sandbee.in/privkey.pem;
  client_max_body_size 21m;
  location = /api/demo/extract {
    proxy_pass http://127.0.0.1:8096;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_http_version 1.1;
    proxy_read_timeout 80s;
    proxy_send_timeout 80s;
    proxy_connect_timeout 5s;
  }
  location / {
    proxy_pass http://127.0.0.1:8094;
    proxy_set_header Host $host;
    # Exactly one trusted edge; overwrite, do not preserve user-supplied XFF.
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_http_version 1.1;
    proxy_read_timeout 80s;
    proxy_send_timeout 80s;
    proxy_connect_timeout 5s;
  }
}
server {
  listen 80;
  server_name store.sandbee.in;
  return 301 https://$host$request_uri;
}
